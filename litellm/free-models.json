   "limits": "30 RPM, 1K RPD, 8K TPM, 200K TPD per model (https://console.groq.com/docs/rate-limits)",
   "notes": "8K TPM means any request over ~8K tokens fails; capped with max_input below",
   "quota": {
    "per": "model",
    "window": "day",
    "requests": 1000,
    "tokens": 200000
   }
  },
  "zai": {
   "key": "ZAI_API_KEY",
   "api_base": "https://api.z.ai/api/paas/v4",
   "free_basis": "only GLM-4.7-Flash and GLM-4.5-Flash are listed Free (https://docs.z.ai/guides/overview/pricing); every other GLM, including glm-5.3-flash, is paid",
   "limits": "not published; see z.ai/manage-apikey/rate-limits",
   "notes": "the two free models did not appear in this key's /models list"
  },
  "cohere": {
   "key": "COHERE_API_KEY",
   "free_basis": "'API calls made from a Trial API key are free' (https://cohere.com/pricing)",
   "limits": "20 RPM per chat model; 1,000 calls/month per trial key (https://docs.cohere.com/docs/rate-limits)",
   "notes": "trial keys are not for production or commercial use; last resort only",
   "quota": {
    "per": "provider",
    "window": "month",
    "requests": 1000
   }
  },
  "cerebras": {
   "key": "CEREBRAS_API_KEY",
   "free_basis": "one-time $5 trial credit, expires 30 days after grant; access stops when used up (https://inference-docs.cerebras.ai/support/rate-limits)",
   "limits": "5 RPM, 30K uncached TPM, 1M tokens/day; trial context 64K, output 32K",
   "notes": "not a lasting free tier; last resort only"
  }
