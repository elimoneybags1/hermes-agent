{
 "about": "Every model Team may call through its LiteLLM proxy, with why it is free. Researched 2026-10-26 from each provider's own pricing/terms pages. build.py generates config.yaml from this file and refuses any routed model whose free is not 'yes' or 'allowance', or whose provider is blocked. tier/order: which auto-router tier the model serves and its priority there (1 is tried first; higher orders only when lower ones are rate-limited or failing). tier null = free but not routed.",
 "blocked_providers": {
  "anthropic": "paid API key; Claude runs through the subscription only",
  "minimax": "Eli: billing is set up on this account",
  "dashscope": "1M free tokens per model, then billed unless 'Free Quota Only' is switched on per model in the Model Studio console; unblock only after that is done"
 },
 "providers": {
  "openrouter": {
   "key": "OPENROUTER_API_KEY",
   "free_basis": "':free' models are priced $0 (GET /api/v1/models)",
   "limits": "shared per-account daily cap on free models (HTTP 429 free-models-per-day)",
   "notes": "this key holds credit ($3.198 used as of 2026-10-26); spend_guard trips if usage rises"
  },
  "nvidia": {
   "key": "NVIDIA_API_KEY",
   "free_basis": "Developer Program members get free hosted NIM endpoints; credits system removed 2025 (https://forums.developer.nvidia.com/t/cannot-find-the-amount-of-credits-left-on-nim-api/337051)",
   "limits": "~40 RPM per account across models (NVIDIA forum moderator, 2026-05-13); no RPD/TPM published",
   "notes": "terms: prototyping/research/development/testing only; trial ToS may let NVIDIA use inputs",
   "quota": {
    "per": "provider",
    "window": "minute",
    "requests": 40
   }
  },
  "gemini": {
   "key": "GEMINI_API_KEY",
   "free_basis": "'Free of charge' in the Free Tier column (https://ai.google.dev/gemini-api/docs/pricing)",
   "limits": "per project, shown only in AI Studio",
   "notes": "free only while billing is OFF on the key's Google Cloud project; free-tier prompts may be used to improve Google products and read by reviewers"
  },
  "mistral": {
   "key": "MISTRAL_API_KEY",
   "free_basis": "Free mode: 'included monthly usage within the limits shown on the Limits page' (https://docs.mistral.ai/admin/billing-usage/usage-limits)",
