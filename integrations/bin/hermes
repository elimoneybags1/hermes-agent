#!/bin/sh
# Run Hermes from this checkout inside its own home, pointed at the local gateway,
# with one profile per project.
#
# HERMES_HOME, the runtime/tool store and the kanban home live under
# $TEAM_STATE (default $HOME/state/team), never ~/.hermes, which is another
# project's install. Every paid-provider and Anthropic variable is removed so
# a stray key in the shell can never reach a profile: provider keys exist only
# in Portkey's state. The Python environment is provisioned and synced by
# upstream's PM through scripts/run-in-hermes-env (pinned uv, pinned Python).
#
# Layers:
#   integrations/hermes/base/   locked config merged on top of every profile
#                               (HERMES_MANAGED_DIR): gateway, free-only, shared skills
#   default profile             main: the overall configuration, launched from this repo
#   project profiles            main plus project additions; one per project, made on
#                               the first launch there by cloning default; picked by
#                               integrations/bin/hermes-project. Every launch, automatic
#                               or -p <name>, brings it up to date with main
#                               (integrations/hermes/inherit.py).
#
# An explicit -p/--profile, or the `profile` subcommand, skips the automatic choice.
set -eu
SELF="$0"
while [ -L "$SELF" ]; do
    _target="$(readlink "$SELF")"
    case "$_target" in /*) SELF="$_target" ;; *) SELF="$(dirname "$SELF")/$_target" ;; esac
done
BIN="$(cd "$(dirname "$SELF")" && pwd)"
REPO="$(cd "$BIN/../.." && pwd)"
TEAM_STATE="${TEAM_STATE:-$HOME/state/team}"
export TEAM_STATE
export HERMES_HOME="$TEAM_STATE/hermes"
export HERMES_RUNTIME_DIR="$TEAM_STATE/hermes-runtime"
export HERMES_KANBAN_HOME="$TEAM_STATE/kanban"
export HERMES_MANAGED_DIR="$REPO/integrations/hermes/base"
# Hermes Desktop (`hermes desktop`) runs its backend through this wrapper, not a
# bare `hermes` it finds, so it gets this home, the base layer and no paid keys.
export HERMES_DESKTOP_HERMES="$BIN/hermes"
mkdir -p "$HERMES_HOME" "$HERMES_RUNTIME_DIR" "$HERMES_KANBAN_HOME"

# The gateway skill: a symlink in the shared (default) skills, so an edit in the repo is live.
SKILL_LINK="$HERMES_HOME/skills/devops/model-gateway"
if [ ! -e "$SKILL_LINK" ]; then
    mkdir -p "$(dirname "$SKILL_LINK")"
    ln -s "$REPO/integrations/hermes/skills/model-gateway" "$SKILL_LINK"
fi

# The LiteLLM master key is the only credential a Hermes profile may use.
if [ -r "$TEAM_STATE/litellm/.env" ]; then
    LITELLM_MASTER_KEY="$(sed -n 's/^LITELLM_MASTER_KEY=//p' "$TEAM_STATE/litellm/.env" | tail -1)"
    [ -n "$LITELLM_MASTER_KEY" ] && export LITELLM_MASTER_KEY
fi

unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
      CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX \
      OPENAI_API_KEY OPENROUTER_API_KEY NVIDIA_API_KEY GROQ_API_KEY \
      GEMINI_API_KEY GOOGLE_API_KEY MISTRAL_API_KEY COHERE_API_KEY \
      CEREBRAS_API_KEY ZAI_API_KEY MINIMAX_API_KEY DASHSCOPE_API_KEY \
      NOUS_API_KEY 2>/dev/null || true

# An inherited activation marker is not proof the inherited PATH still leads to
# Hermes's Python: Desktop's children carry the marker but a login-shell PATH
# where /usr/bin/python3 (3.9) comes first. Drop it so run-in-hermes-env always
# applies the environment itself, as it already does from a plain terminal.
unset __HERMES_ACTIVATED

HERMES() { "$REPO/scripts/run-in-hermes-env" python3 "$REPO/hermes" "$@"; }

# `-p default` passes only when Hermes resolves it to this HERMES_HOME. Current
# Hermes treats a HERMES_HOME outside ~/.hermes as its own root, so it does
# (Desktop sends `gateway ensure -p default`); older code resolved it to
# ~/.hermes, another install with paid keys, so ask Hermes rather than assume.
prev=""
for a in "$@"; do
    case "$prev:$a" in
        -p:default|--profile:default|*:--profile=default)
            check_err="$(mktemp)"
            resolved="$("$REPO/scripts/run-in-hermes-env" python3 -c \
                'import sys; sys.path.insert(0, sys.argv[1]); from hermes_cli.profiles import get_profile_dir; print(get_profile_dir("default"))' \
                "$REPO" 2>"$check_err" | tail -1)" || true
            if [ "$resolved" != "$HERMES_HOME" ]; then
                echo "hermes: '-p default' resolves to '${resolved:-?}', not the Team home $HERMES_HOME; refusing ($(tail -3 "$check_err" | tr '\n' ' '))" >&2
                rm -f "$check_err"
                exit 2
            fi
            rm -f "$check_err" ;;
    esac
    prev="$a"
done

# Bring a project profile up to date with main (default): shared lists, shared
# skills, SOUL.md = main's + SOUL.project.md. See integrations/hermes/inherit.py.
# A stamp keeps it off the common path: it runs only when one of its inputs changed.
inherit_from_main() {
    PDIR="$HERMES_HOME/profiles/$1"
    [ "$1" != default ] && [ -f "$PDIR/config.yaml" ] || return 0
    STAMP="$PDIR/.inherited"
    if [ -f "$STAMP" ] && [ -z "$(find "$HERMES_HOME/config.yaml" "$HERMES_HOME/SOUL.md" \
            "$PDIR/config.yaml" "$PDIR/SOUL.md" "$PDIR/SOUL.project.md" -newer "$STAMP" 2>/dev/null)" ]; then
        return 0
    fi
    if "$REPO/scripts/run-in-hermes-env" python3 "$REPO/integrations/hermes/inherit.py" "$HERMES_HOME" "$1" >&2; then
        touch "$STAMP"
    else
        echo "hermes: could not bring profile '$1' up to date with main; starting it as it is" >&2
    fi
}

# A profile with its own gh login ($PDIR/gh) is the only one holding that
# credential: gh, and git through gh's credential helper, use it. Hermes strips
# GH_TOKEN from every terminal, so a config directory is the way to scope it.
scope_github() {
    if [ "$1" != default ] && [ -d "$HERMES_HOME/profiles/$1/gh" ]; then
        export GH_CONFIG_DIR="$HERMES_HOME/profiles/$1/gh"
    fi
}

explicit=no
EXPLICIT_PROFILE=""
prev=""
for a in "$@"; do
    case "$prev" in -p|--profile) EXPLICIT_PROFILE="$a" ;; esac
    case "$a" in
        --profile=*) explicit=yes; EXPLICIT_PROFILE="${a#--profile=}" ;;
        -p|--profile|profile) explicit=yes ;;
    esac
    prev="$a"
done
if [ "$explicit" = yes ]; then
    if [ -n "$EXPLICIT_PROFILE" ]; then
        inherit_from_main "$EXPLICIT_PROFILE"
        scope_github "$EXPLICIT_PROFILE"
    fi
    HERMES "$@"
    exit $?
fi

# Here the directory picks the profile. A sticky `hermes profile use <name>` (or a
# profile switch in Desktop) writes active_profile, which Hermes applies whenever
# no -p is given, so main would silently start as that profile. Clear it.
STICKY="$HERMES_HOME/active_profile"
if [ -f "$STICKY" ]; then
    sticky_name="$(tr -d '[:space:]' < "$STICKY")"
    if [ -n "$sticky_name" ] && [ "$sticky_name" != default ]; then
        echo "hermes: cleared the sticky profile '$sticky_name'; the folder picks the profile here (use -p <name> to choose one)" >&2
    fi
    rm -f "$STICKY"
fi

PROFILE="$("$BIN/hermes-project")"
if [ "$PROFILE" != default ] && [ ! -f "$HERMES_HOME/profiles/$PROFILE/config.yaml" ]; then
    # First launch in this project: clone the Team (default) profile once. A lock
    # directory keeps two panes opening at the same moment from both creating it.
    LOCK="$HERMES_HOME/profiles/.creating-$PROFILE"
    mkdir -p "$HERMES_HOME/profiles"
    if mkdir "$LOCK" 2>/dev/null; then
        trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
        echo "hermes: new project, creating profile '$PROFILE' from the Team profile" >&2
        HERMES profile create "$PROFILE" --clone-from default --no-alias \
            --description "Project profile for $(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || pwd)" >&2
        # Shared skills come live from the Team profile through skills.external_dirs
        # (the base layer); the clone's copies would freeze them, so start empty and
        # keep `hermes update` from re-seeding bundled skills into this profile.
        PDIR="$HERMES_HOME/profiles/$PROFILE"
        rm -rf "$PDIR/skills"
        mkdir "$PDIR/skills"
        : > "$PDIR/.no-bundled-skills"
        rmdir "$LOCK" 2>/dev/null || true
        trap - EXIT
    else
        echo "hermes: profile '$PROFILE' is being created in another pane; waiting" >&2
        while [ -d "$LOCK" ]; do sleep 1; done
    fi
fi

inherit_from_main "$PROFILE"
scope_github "$PROFILE"

if [ "$PROFILE" = default ]; then
    # Team: the base home itself, the overall setup. No profile flag.
    exec "$REPO/scripts/run-in-hermes-env" python3 "$REPO/hermes" "$@"
fi
exec "$REPO/scripts/run-in-hermes-env" python3 "$REPO/hermes" -p "$PROFILE" "$@"
