{
 "about": "Every model Team may call, and which providers serve it, with why each is free. Hand-edited; the one source of truth. build.py turns it into Portkey configs (one per model, one per tier), LiteLLM's config.yaml and Portkey's conf.json, and refuses any served_by whose free is not 'yes' or 'allowance', any blocked or unknown provider, any OpenRouter id that is not a ':free' variant. Model rows researched 2026-10-26 from each provider's own pricing and terms pages (archived as git show before-fresh-start:litellm/free-models.json) and folded into one row per model on 2026-10-27. tier/order: which LiteLLM tier group the model serves and its priority there (1 first; higher orders only when lower ones are cooling down or failing). tier null = free but not routed; 'unrouted' says why, or 'unavailable' when no provider serves it today. served_by: the providers that serve the model, in Portkey's failover order; 'unavailable' entries are kept on record and skipped by build.py.",
 "gateway": {
  "port": 8788,
  "port_why": "PLAN.md says 8787, but 127.0.0.1:8787 is held by the launchd job com.fullmoney.myprof-gateway (another project's node gateway, running since 2026-10-09). Change this number and rebuild to move; nothing else hardcodes it.",
  "host": "127.0.0.1"
 },
 "litellm": {
  "port": 4000,
  "host": "127.0.0.1"
 },
 "blocked_providers": {
  "anthropic": "paid API key; Claude runs through the subscription only",
  "minimax": "Eli: billing is set up on this account",
  "dashscope": "1M free tokens per model, then billed unless 'Free Quota Only' is switched on per model in the Model Studio console; unblock only after that is done"
 },
 "providers": {
  "openrouter": {
   "portkey": "openrouter",
   "key_env": "OPENROUTER_API_KEY",
   "free_basis": "':free' models are priced $0 (GET /api/v1/models)",
   "limits": "shared per-account daily cap on free models (HTTP 429 free-models-per-day)",
   "notes": "this key holds credit ($3.198 used as of 2026-10-26); the spend guard trips if usage rises"
  },
  "nvidia": {
   "portkey": "openai",
   "custom_host": "https://integrate.api.nvidia.com/v1",
   "key_env": "NVIDIA_API_KEY",
   "free_basis": "Developer Program members get free hosted NIM endpoints; credits system removed 2025 (https://forums.developer.nvidia.com/t/cannot-find-the-amount-of-credits-left-on-nim-api/337051)",
   "limits": "~40 RPM per account across models (NVIDIA forum moderator, 2026-05-13); no RPD/TPM published",
   "notes": "terms: prototyping/research/development/testing only; trial ToS may let NVIDIA use inputs. 2026-10-26: 33 of 44 calls ok, ResourceExhausted/timeouts up to 181s",
   "request_timeout_ms": 90000
  },
  "gemini": {
   "portkey": "google",
   "key_env": "GEMINI_API_KEY",
   "free_basis": "'Free of charge' in the Free Tier column (https://ai.google.dev/gemini-api/docs/pricing)",
   "limits": "per project, shown only in AI Studio",
   "notes": "free only while billing is OFF on the key's Google Cloud project; free-tier prompts may be used to improve Google products and read by reviewers. 2026-10-27: free-tier latency 6-32 s on flash-lite and two 60 s timeouts on 3.8-flash, so the Portkey target timeout is 120 s",
   "request_timeout_ms": 120000
  },
  "mistral": {
   "portkey": "mistral-ai",
   "key_env": "MISTRAL_API_KEY",
   "free_basis": "Free mode: 'included monthly usage within the limits shown on the Limits page' (https://docs.mistral.ai/admin/billing-usage/usage-limits)",
   "limits": "per model, shown only in admin.mistral.ai; third-party: 1 RPS, 500K TPM, 1B tokens/month",
   "notes": "free API data may be used for training unless switched off (Admin Console > Privacy)"
  },
  "groq": {
   "portkey": "groq",
   "key_env": "GROQ_API_KEY",
   "free_basis": "$0 Free plan; card needed only to upgrade (https://console.groq.com/docs/billing-faqs)",
   "limits": "30 RPM, 1K RPD, 8K TPM, 200K TPD per model (https://console.groq.com/docs/rate-limits)",
   "notes": "8K TPM means any request over ~8K tokens fails; served_by rows carry max_input 6000"
  },
  "zai": {
   "portkey": "z-ai",
   "key_env": "ZAI_API_KEY",
   "free_basis": "only GLM-4.7-Flash and GLM-4.5-Flash are listed Free (https://docs.z.ai/guides/overview/pricing); every other GLM, including glm-5.3-flash, is paid",
   "limits": "not published; see z.ai/manage-apikey/rate-limits",
   "notes": "the two free models did not appear in this key's /models list on 2026-10-26"
  },
  "cohere": {
   "portkey": "cohere",
   "key_env": "COHERE_API_KEY",
   "free_basis": "'API calls made from a Trial API key are free' (https://cohere.com/pricing)",
   "limits": "20 RPM per chat model; 1,000 calls/month per trial key (https://docs.cohere.com/docs/rate-limits)",
   "notes": "trial keys are not for production or commercial use; last resort only, so it is last in every served_by list"
  },
  "cerebras": {
   "portkey": "cerebras",
   "key_env": "CEREBRAS_API_KEY",
   "free_basis": "one-time $5 trial credit, expires 30 days after grant; access stops when used up (https://inference-docs.cerebras.ai/support/rate-limits)",
   "limits": "5 RPM, 30K uncached TPM, 1M tokens/day; trial context 64K, output 32K",
   "notes": "not a lasting free tier; 'Payment required' since 2026-10-26, every cerebras served_by row is unavailable"
  }
 },
