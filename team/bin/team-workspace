#!/bin/sh
# Keep conversations, profiles, boards, and usage separate while sharing Team code.
set -eu
if [ "$#" -lt 2 ]; then
    printf 'usage: team-workspace NAME COMMAND [ARGS...]\n' >&2
    exit 2
fi
workspace_name="$1"
case "$workspace_name" in
    ''|*[!a-z0-9_-]*|-*|_*) printf 'workspace name must start with a letter or digit and contain only lowercase letters, digits, _ or -\n' >&2; exit 2 ;;
esac
shift
export TEAM_STATE="$HOME/state/team-$workspace_name"
exec "$(dirname "$0")/team" "$@"
