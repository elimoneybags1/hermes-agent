#!/usr/bin/env python3
"""Run the worktree's canonical test runner with the main checkout's PM environment."""

import os
from pathlib import Path
import subprocess
import sys


def main():
    worktree = Path.cwd().resolve()
    env = dict(os.environ)
    if len(sys.argv) == 1:
        common = subprocess.check_output(
            [
                "git",
                "-C",
                str(worktree),
                "rev-parse",
                "--path-format=absolute",
                "--git-common-dir",
            ],
            text=True,
        ).strip()
        main_repo = Path(env.get("TEAM_MAIN_REPO", str(Path(common).parent))).resolve()
        state = Path(env.get("TEAM_STATE", str(Path.home() / "state" / "team")))
        env.update(
            TEAM_STATE=str(state),
            HERMES_HOME=str(state / "hermes"),
            HERMES_RUNTIME_DIR=str(state / "hermes-runtime"),
        )
        return subprocess.call(
            [
                str(main_repo / "scripts/run-in-hermes-env"),
                "python3",
                str(Path(__file__).resolve()),
                str(worktree),
            ],
            cwd=main_repo,
            env=env,
        )
    worktree = Path(sys.argv[1]).resolve()
    python = env.get("__HERMES_TEST_PYTHON", "")
    if not python or not Path(python).is_file():
        print("team-check: activation provided no PM test interpreter", file=sys.stderr)
        return 2
    env.pop("__HERMES_ACTIVATED", None)
    env["HERMES_PYTHON"] = python
    tests = subprocess.call(
        [str(worktree / "scripts/run_tests.sh"), "tests/team", "--file-retries", "0"],
        cwd=worktree,
        env=env,
    )
    lint = subprocess.call(
        [
            python,
            "-m",
            "ruff",
            "check",
            "team",
            "plugins/team",
            "tests/team",
            "--output-format",
            "concise",
        ],
        cwd=worktree,
        env=env,
    )
    return tests or lint


if __name__ == "__main__":
    sys.exit(main())
